-- AUTO REPAIR
local function getHammer()
    local character = Player.Character
    local hammer = character and character:FindFirstChild("Hammer")

    if not hammer then
        local backpack = Player:FindFirstChild("Backpack")
        hammer = backpack and backpack:FindFirstChild("Hammer")
    end

    return hammer
end

local function getRepairDistance(root, building)
    local success, pivot = pcall(function()
        return building:GetPivot()
    end)

    if not success then
        return math.huge
    end

    return (root.Position - pivot.Position).Magnitude
end

local function repairNearby()
    if not State.Repair then
        return
    end

    local character = Player.Character
    local root = character and character:FindFirstChild(
        "HumanoidRootPart"
    )

    local hammer = getHammer()
    local event = hammer and hammer:FindFirstChild("RemoteEvent")

    local buildings = Workspace:FindFirstChild("Buildings")
    local myBuildings = buildings and buildings:FindFirstChild(
        tostring(Player.UserId)
    )

    if not root
        or not event
        or not event:IsA("RemoteEvent")
        or not myBuildings then
        return
    end

    for _, building in ipairs(myBuildings:GetChildren()) do
        if not State.Repair then
            break
        end

        local health = building:FindFirstChild("BuildingHealth")

        if health and health:IsA("NumberValue") then
            local maxHealth = health:GetAttribute("MaxHealth")

            if maxHealth
                and health.Value < maxHealth
                and getRepairDistance(root, building) <= REPAIR_RANGE then

                event:FireServer("Repair", health)
            end
        end
    end
end

toggle("Auto Repair", function(v)
    State.Repair = v
end)

task.spawn(function()
    while gui.Parent do
        if State.Repair then
            pcall(repairNearby)
        end

        task.wait(REPAIR_INTERVAL)
    end
end)

