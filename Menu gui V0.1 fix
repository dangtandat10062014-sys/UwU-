local function getEquippedToolRemote()
    local character = Player.Character

    if not character then
        return nil
    end

    local tool = character:FindFirstChildOfClass("Tool")

    if not tool then
        return nil
    end

    local remote = tool:FindFirstChild("RemoteEvent")

    if remote and remote:IsA("RemoteEvent") then
        return remote
    end

    return nil
end

local function getZombiePart(zombie)
    return zombie:FindFirstChild("HumanoidRootPart")
        or zombie:FindFirstChild("Torso")
        or zombie:FindFirstChild("UpperTorso")
        or zombie:FindFirstChildWhichIsA("BasePart", true)
end

local function pushZombies()
    if not State.AutoPush then
        return
    end

    local character = Player.Character
    local root = character and character:FindFirstChild(
        "HumanoidRootPart"
    )

    local zombies = Workspace:FindFirstChild("Zombies")
    local remote = getEquippedToolRemote()

    if not root or not zombies or not remote then
        return
    end

    local now = os.clock()

    for _, zombie in ipairs(zombies:GetChildren()) do
        if not State.AutoPush then
            break
        end

        if not zombie:IsA("Model") then
            continue
        end

        local part = getZombiePart(zombie)

        if not part then
            continue
        end

        local distance = (
            root.Position - part.Position
        ).Magnitude

        if distance <= PUSH_RANGE then
            local previous = lastPush[zombie] or 0

            if now - previous >= PUSH_COOLDOWN then
                lastPush[zombie] = now

                remote:FireServer("StopBraceBlock")

                remote:FireServer(
                    "FeedbackStun",
                    zombie,
                    part.Position
                )
            end
        end
    end

    for zombie, timestamp in pairs(lastPush) do
        if not zombie.Parent or now - timestamp > 10 then
            lastPush[zombie] = nil
        end
    end
end

