section("PLAYER")

local function setupSpeed(character)
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end

    if not State.Speed then
        return
    end

    local humanoid = character:WaitForChild("Humanoid", 5)

    if not humanoid or not State.Speed then
        return
    end

    lastSpeed = humanoid.WalkSpeed

    local function setSpeed(value)
        internalSpeedChange = true
        humanoid.WalkSpeed = value
        lastSpeed = value
        internalSpeedChange = false
    end

    if humanoid.WalkSpeed < DEFAULT_SPEED then
        setSpeed(DEFAULT_SPEED)
    end

    speedConnection = humanoid:GetPropertyChangedSignal(
        "WalkSpeed"
    ):Connect(function()
        if internalSpeedChange or not State.Speed then
            return
        end

        local current = humanoid.WalkSpeed

        if current < DEFAULT_SPEED then
            setSpeed(DEFAULT_SPEED)
        elseif current > lastSpeed then
            setSpeed(current + BONUS_SPEED)
        else
            lastSpeed = current
        end
    end)
end

toggle("Auto Speed", function(v)
    State.Speed = v

    if v and Player.Character then
        task.spawn(setupSpeed, Player.Character)
    elseif speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
end)

Player.CharacterAdded:Connect(function(character)
    if State.Speed then
        task.spawn(setupSpeed, character)
    end
end)

