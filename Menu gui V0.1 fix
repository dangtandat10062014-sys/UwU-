local function removeHitboxes()
    for npc, hitbox in pairs(trackedNPCs) do
        if hitbox and hitbox.Parent then
            hitbox:Destroy()
        end

        trackedNPCs[npc] = nil
    end
end

local function setupNPC(npc)
    if not State.Hitbox
        or not npc:IsA("Model")
        or trackedNPCs[npc] then
        return
    end

    if Players:GetPlayerFromCharacter(npc) then
        return
    end

    local head = npc:FindFirstChild("Head")

    if not head
        or not head:IsA("BasePart")
        or npc:FindFirstChild(HITBOX_NAME) then
        return
    end

    local hitbox = Instance.new("Part")
    hitbox.Name = HITBOX_NAME
    hitbox.Size = HITBOX_SIZE
    hitbox.Transparency = 1
    hitbox.CanCollide = false
    hitbox.CanTouch = false
    hitbox.CanQuery = true
    hitbox.Massless = true
    hitbox.CFrame = head.CFrame
    hitbox.Parent = npc

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = head
    weld.Part1 = hitbox
    weld.Parent = hitbox

    trackedNPCs[npc] = hitbox
end

